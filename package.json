{
  "name": "global-alpha-tech-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Website for Global Alpha Tech, a digital growth studio in Delhi. Static Astro build, deployed to Hostinger.",
  "scripts": {
    "dev": "astro dev --port 5190",
    "build": "astro build",
    "preview": "astro preview --port 5190",
    "brand": "node scripts/build-brand.mjs",
    "prompts": "node scripts/write-image-prompts.mjs",
    "check": "astro build && node scripts/check-site.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.2.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  }
}
