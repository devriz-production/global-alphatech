---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import WorkCard from '../components/WorkCard.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, cta } from '../data/site';
import { services } from '../data/services';
import { reasons, process, industries } from '../data/company';
import { projects } from '../data/work';
import { faqs } from '../data/faqs';

const words = ['clinics', 'schools', 'startups', 'gyms', 'brands', 'studios', 'retailers'];
const quick = ['seo-services', 'performance-marketing', 'website-development', 'social-media-marketing', 'app-development', 'branding-graphic-design'];
const featured = projects.slice(0, 4);
const layout = [
  { col: 'md:col-span-7', ratio: '4/3' },
  { col: 'md:col-span-5 md:mt-24', ratio: '4/5' },
  { col: 'md:col-span-5', ratio: '4/5' },
  { col: 'md:col-span-7 md:mt-24', ratio: '4/3' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base
  title="Global Alpha Tech | Digital Marketing, SEO and Website Development in Delhi"
  description="Global Alpha Tech is a digital growth studio in Laxmi Nagar, Delhi. One team for SEO, Google and Meta ads, websites, apps, social media and branding, measured on enquiries and sales."
  schema={faqSchema}
>
  <!-- Hero -->
  <section class="new-hero wrap" aria-labelledby="hero-title">
    <div class="new-hero__rail">
      <p class="eyebrow" data-reveal><span class="live-dot"></span> Digital growth studio / Delhi, India</p>
      <p class="eyebrow hidden md:block" data-reveal style="--d:100ms">Independent since 2018</p>
    </div>
    <div class="new-hero__grid">
      <div class="new-hero__copy">
        <p class="hero-index" data-reveal>01 / The new business signal</p>
        <h1 id="hero-title" class="new-hero__title" data-lines>
          <span class="line"><span>Make your</span></span>
          <span class="line"><span class="hero-outline">next move</span></span>
          <span class="line"><span>visible.</span></span>
        </h1>
        <p class="new-hero__intro" data-reveal style="--d:180ms">
          {site.name} builds the digital systems ambitious teams need to be found, trusted and chosen - from first click to final conversion.
        </p>
        <div class="new-hero__actions" data-reveal style="--d:240ms">
          <a href={cta.href} class="btn btn-alpha">{cta.label}<Icon name="arrow-up-right" size={17} /></a>
          <a href="/work/" class="text-link">Explore our work <Icon name="arrow-right" size={16} /></a>
        </div>
      </div>
      <div class="new-hero__media" data-reveal style="--d:140ms">
        <div class="new-hero__media-card">
          <Media id="home-img-5" alt="Devriz Group multi-sector corporate enterprise portal" fill fit="contain" imgClass="object-center" />
          <span class="new-hero__media-label">Devriz Group / Corporate system</span>
        </div>
        <div class="new-hero__media-card">
          <Media id="home-img-4" alt="Devriz Professional Shopify skincare storefront" fill fit="contain" imgClass="object-center" />
          <span class="new-hero__media-label">Devriz Professional / Shopify commerce</span>
        </div>
        <div class="new-hero__stamp">GA<span>+</span></div>
      </div>
    </div>
    <div class="new-hero__footer" data-reveal style="--d:300ms">
      <span>Scroll to explore</span><span class="hero-line"></span><span>Strategy · Design · Technology</span>
    </div>
  </section>

  <!-- Work index -->
  <section class="work-index wrap" aria-label="Selected work and capabilities">
    <div class="work-index__heading">
      <p class="eyebrow">02 / What we make</p>
      <h2 class="section-title">Useful <em>attention.</em></h2>
      <p class="max-w-md text-muted">A focused team for the moments where your business needs to look sharper, move faster and convert more.</p>
    </div>
    <div class="work-index__grid">
      <a href="/services/website-development/" class="work-tile work-tile--wide" data-reveal>
        <Media id="home-img-3" alt="Kotil Skin Science clinic and academy website" quiet fill imgClass="object-contain object-top" />
        <span class="work-tile__shade"></span><span class="work-tile__meta"><b>01</b><strong>Websites that work</strong><i>↗</i></span>
      </a>
      <a href="/services/performance-marketing/" class="work-tile work-tile--tall" data-reveal style="--d:100ms">
        <Media id="home-img-1" alt="Meta Ads Manager multi-platform campaign previews" quiet fill imgClass="object-contain object-top" />
        <span class="work-tile__shade"></span><span class="work-tile__meta"><b>02</b><strong>Demand, directed</strong><i>↗</i></span>
      </a>
      <div class="work-note" data-reveal style="--d:160ms"><span class="eyebrow">A sharper point of view</span><p>We bring strategy, creative and performance into the same room. No handoffs. No noise. Just work that earns its place in the market.</p><a class="text-link" href="/about/">Meet the studio <Icon name="arrow-up-right" size={16} /></a></div>
      <a href="/services/website-development/" class="work-tile work-tile--small" data-reveal style="--d:220ms">
        <Media id="home-img-4" alt="Devriz Professional D2C skincare e-commerce website" quiet fill imgClass="object-contain object-top" />
        <span class="work-tile__shade"></span><span class="work-tile__meta"><b>03</b><strong>Commerce, considered</strong><i>↗</i></span>
      </a>
    </div>
  </section>

  <!-- Marquee -->
  <div class="marquee my-4 md:my-6 border-y border-line py-3 md:py-4" aria-hidden="true">
    <div class="marquee-track" style="--speed:60s">
      {
        [0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {services.map((s) => (
              <span class="flex items-center">
                <span class="px-6 font-display text-[clamp(1.75rem,4vw,3.5rem)] leading-none font-[680] tracking-[-0.035em] whitespace-nowrap md:px-8" style="font-stretch:88%">
                  {s.short.charAt(0).toUpperCase() + s.short.slice(1)}
                </span>
                <Mark size={28} class="text-muted" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- Statement -->
  <section class="wrap pt-6 pb-14 md:pt-8 md:pb-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-8">
        <p class="kicker mb-8" data-reveal>The studio</p>
  <div class="max-w-4xl" data-reveal>
  <h2 class="font-display text-[clamp(1.85rem,3.2vw,3.4rem)] leading-[1.08] font-[600] tracking-[-0.035em]">
  Strategy, creative and performance in one studio.
  </h2>
  <p class="mt-5 max-w-2xl text-base leading-7 text-muted md:text-lg md:leading-8">
  We are strategists, designers, developers and marketers working together from Delhi. Your website, search rankings, ads and content pull in one direction: towards customers.
  </p>
  </div>
  <div class="mt-8 flex flex-wrap gap-x-10 gap-y-6 border-t border-border/70 pt-6" data-reveal style="--d:120ms">
          <div>
            <p class="font-display text-4xl font-[700] tracking-tight">{services.length}</p>
            <p class="mt-1 text-sm text-muted">services, one team</p>
          </div>
          <div>
            <p class="font-display text-4xl font-[700] tracking-tight">1</p>
            <p class="mt-1 text-sm text-muted">point of contact for you</p>
          </div>
          <div>
            <p class="font-display text-4xl font-[700] tracking-tight">100%</p>
            <p class="mt-1 text-sm text-muted">of accounts in your name</p>
          </div>
        </div>
      </div>
      <div class="lg:col-span-4" data-reveal style="--d:150ms">
        <Media id="studio-team" alt="The Global Alpha Tech team at work in the studio" class="aspect-[4/5] rounded-[1.25rem]" sizes="(min-width: 1024px) 33vw, 100vw" />
        <a href="/about/" class="link-arrow mt-5">About the studio <Icon name="arrow-up-right" size={18} /></a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="wrap section-y pt-0" aria-labelledby="services-title">
    <SectionHead index="01" label="Services" title="Everything online," light="from one team." intro="Pick one service or let us combine them into a plan. Hover a service to preview it, or open it for the full scope." link={{ label: 'All services', href: '/services/' }} />
    <div class="mt-14 md:mt-20">
      <ServiceIndex />
    </div>
  </section>

  <!-- Why -->
  <section class="section-y relative overflow-hidden" aria-label="Why Global Alpha Tech">
    <Mark size={640} quiet class="pointer-events-none absolute -top-40 -right-40 text-white/[0.04]" />
    <div class="wrap relative">
      <SectionHead index="02" label="Why Global Alpha Tech" title="Built for revenue," light="not for reports." intro="Plenty of agencies can post, design or run ads. Fewer will tie that work to the money it makes you and show you the numbers every month." />
      <ol class="mt-16 grid gap-px overflow-hidden rounded-[1.25rem] bg-line md:mt-20 md:grid-cols-2 lg:grid-cols-3">
        {
          reasons.map((r, i) => (
            <li class="flex min-h-[15rem] flex-col justify-between gap-10 bg-bg p-7 md:p-9" data-reveal style={`--d:${(i % 3) * 90}ms`}>
              <span class="font-mono text-xs text-alpha-light">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="t-h4 md:text-[1.4rem]">{r.title}</h3>
                <p class="mt-3 text-[0.95rem] text-muted">{r.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Process -->
  <section class="wrap section-y" aria-label="How we work">
    <SectionHead index="03" label="How we work" title="Four steps." light="No surprises." intro="Every engagement follows the same rhythm, whether it is a landing page or a year of growth marketing." link={{ label: 'Plans and pricing', href: '/pricing/' }} />
    <ol class="mt-16 grid gap-10 md:mt-20 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        process.map((step, i) => (
          <li class="group relative pt-8" data-reveal style={`--d:${i * 110}ms`}>
            <span class="absolute top-0 left-0 h-px w-full bg-line-strong" />
            <span class="absolute top-0 left-0 h-px w-full origin-left scale-x-0 bg-alpha transition-transform duration-[1.4s] ease-[var(--ease)] [.is-in>&]:scale-x-100" style={`transition-delay:${300 + i * 200}ms`} />
            <span class="absolute -top-[5px] left-0 size-[11px] rounded-full border-2 border-bg bg-alpha" />
            <p class="font-display text-6xl leading-none font-[220] tracking-[-0.04em] text-muted">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="t-h3 mt-6">{step.title}</h3>
            <p class="mt-3 text-[0.95rem] text-muted">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Work -->
  <section class="wrap section-y pt-0" aria-label="Selected work">
    <SectionHead index="04" label="Selected work" title="Real businesses," light="real results." intro="A few of the projects our clients have described in their own words." link={{ label: 'See all work', href: '/work/' }} />
    <div class="mt-14 grid gap-x-8 gap-y-16 md:mt-20 md:grid-cols-12">
      {featured.map((p, i) => <WorkCard project={p} ratio="16/10" class={layout[i].col} sizes="(min-width: 768px) 55vw, 100vw" />)}
    </div>
  </section>

  <!-- Industries -->
  <section class="border-y border-line bg-surface section-y-sm" aria-label="Industries">
    <div class="wrap grid gap-8 lg:grid-cols-12">
      <p class="kicker lg:col-span-3"><b>05</b>Who we work with</p>
      <ul class="flex flex-wrap gap-x-4 gap-y-2 lg:col-span-9">
        {
          industries.map((name, i) => (
            <li class="flex items-center gap-4 font-display text-[clamp(1.5rem,3vw,2.6rem)] leading-tight font-[600] tracking-[-0.03em]" data-reveal style={`--d:${i * 50}ms`}>
              {name}
              {i < industries.length - 1 && <span class="font-[200] text-muted">/</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Testimonials index="06" />

  <!-- FAQ -->
  <section class="wrap section-y pt-0" aria-labelledby="faq-title">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)]">
          <p class="kicker mb-6" data-reveal><b>07</b>Questions</p>
          <h2 id="faq-title" class="t-h2" data-lines>
            <span class="line"><span>Good questions,</span></span>
            <span class="line"><span class="light" style="--d:100ms">straight answers.</span></span>
          </h2>
          <p class="mt-6 max-w-sm text-muted" data-reveal>
            Something else on your mind? Call <a href={site.phoneHref} class="link-u text-fg">{site.phone}</a> or <a href="/contact/" class="link-u text-fg">send us a message</a>.
          </p>
        </div>
      </div>
      <div class="lg:col-span-8">
        <Faq items={faqs} />
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero-shell {
    position: relative;
    isolation: isolate;
    margin-top: 1rem;
    border: 1px solid var(--color-line);
    border-radius: 2rem;
    background:
      radial-gradient(circle at 82% 18%, color-mix(in srgb, var(--color-alpha) 20%, transparent), transparent 28%),
      linear-gradient(135deg, color-mix(in srgb, var(--color-surface) 92%, transparent), transparent 72%);
    overflow: hidden;
  }

  .hero-shell::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 2rem;
    right: var(--gutter);
    width: min(34rem, 62vw);
    height: min(34rem, 62vw);
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-alpha) 18%, transparent) 0%, transparent 68%);
    filter: blur(8px);
    pointer-events: none;
  }

  .hero-shell::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.32;
    background-image: linear-gradient(var(--color-line) 1px, transparent 1px), linear-gradient(90deg, var(--color-line) 1px, transparent 1px);
    background-size: 4rem 4rem;
    mask-image: linear-gradient(90deg, black, transparent 78%);
    pointer-events: none;
  }

  .hero-topline {
    border-bottom: 1px solid var(--line);
    padding: 0.8rem 0.25rem 1rem;
  }

  .hero-title {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 12.6vw, 13.5rem);
    line-height: 0.88;
    letter-spacing: -0.05em;
    font-weight: 760;
    font-stretch: 84%;
    text-shadow: 0 0 50px color-mix(in srgb, var(--color-alpha) 10%, transparent);
  }

  /* Room for descenders (g, p) inside the masked lines. */
  .hero-title :global(.line) {
    padding-bottom: 0.16em !important;
    margin-bottom: -0.16em !important;
  }

  .cycler {
    display: grid;
    overflow: hidden;
    padding-bottom: 0.16em;
    margin-bottom: -0.16em;
  }

  .cycler :global(.cycler-word) {
    grid-area: 1 / 1;
    justify-self: start;
    white-space: nowrap;
    transform: translateY(150%);
    transition: transform 0.9s var(--ease);
  }

  .cycler :global(.cycler-word.is-current) {
    transform: none;
  }

  .cycler :global(.cycler-word.is-leaving) {
    transform: translateY(-150%);
  }
  .new-hero {
    padding-block: clamp(1.25rem, 3vw, 2.5rem) clamp(4rem, 9vw, 8rem);
  }

  .new-hero__rail,
  .new-hero__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding-block: 1rem;
  }

  .new-hero__footer { border-top: 1px solid var(--line); border-bottom: 0; color: var(--muted); }
  .eyebrow, .hero-index { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .eyebrow { display: inline-flex; align-items: center; gap: .6rem; }
  .hero-index { color: var(--color-alpha); margin-bottom: 1.5rem; }
  .new-hero__grid { display: grid; grid-template-columns: minmax(0, 1.02fr) minmax(18rem, .98fr); align-items: center; gap: clamp(2rem, 6vw, 6rem); min-height: min(56svh, 31rem); padding-block: clamp(.75rem, 1.5vw, 1.5rem); }
  .new-hero__title { font-family: var(--font-display); font-size: clamp(3.6rem, 8.5vw, 7.5rem); line-height: .82; letter-spacing: -.075em; font-weight: 760; }
  .new-hero__title .line { display: block; overflow: hidden; padding-bottom: .12em; margin-bottom: -.12em; }
  .new-hero__title .line > span { display: inline-block; }
  .hero-outline { color: transparent; -webkit-text-stroke: 1px var(--fg); }
  .new-hero__intro { max-width: 28rem; margin-top: 2.25rem; font-size: clamp(1.05rem, 1.5vw, 1.3rem); line-height: 1.45; color: var(--muted); }
  .new-hero__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.25rem; margin-top: 2.25rem; }
  .text-link { display: inline-flex; align-items: center; gap: .5rem; font-weight: 600; color: var(--fg); }
  .text-link:hover { color: var(--color-alpha); }
  .new-hero__media { position: relative; display: grid; grid-template-rows: repeat(2, minmax(0, 1fr)); gap: .75rem; min-height: min(71svh, 43rem); overflow: visible; }
  .new-hero__media-card { position: relative; min-height: 0; overflow: hidden; background: var(--surface); border: 1px solid var(--line); }
  .new-hero__media-card img { filter: saturate(.78) contrast(1.08); transition: transform 1.2s var(--ease); }
  .new-hero__media-card:hover img { transform: scale(1.025); }
  .new-hero__media-label { position: absolute; inset: auto .8rem .7rem; color: white; font-family: var(--font-mono); font-size: .58rem; text-transform: uppercase; letter-spacing: .08em; text-shadow: 0 1px 10px rgb(0 0 0 / .7); }
  .new-hero__stamp { position: absolute; top: .8rem; right: .8rem; z-index: 2; display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border: 1px solid rgb(255 255 255 / .7); border-radius: 50%; color: white; font-family: var(--font-display); font-size: .9rem; font-weight: 700; transform: rotate(12deg); }
  .new-hero__stamp span { color: var(--color-alpha); }
  .hero-line { height: 1px; flex: 1; background: var(--line); }
  .work-index { padding-block: clamp(2.5rem, 5vw, 4rem); }
  .work-index__heading { display: grid; grid-template-columns: 1fr 1.3fr 1fr; align-items: end; gap: 2rem; margin-bottom: clamp(2.5rem, 6vw, 5rem); }
  .section-title { font-family: var(--font-display); font-size: clamp(3rem, 6vw, 6rem); line-height: .88; letter-spacing: -.06em; font-weight: 720; }
  .section-title em { color: var(--color-alpha); font-style: normal; }
  .work-index__grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 1rem; }
  .work-tile { position: relative; min-height: 20rem; overflow: hidden; background: var(--surface); }
  .work-tile--wide { min-height: clamp(22rem, 42vw, 38rem); }
  .work-tile--tall { min-height: clamp(28rem, 52vw, 46rem); }
  .work-tile--small { min-height: clamp(18rem, 26vw, 26rem); }
  .work-tile img { transition: transform 1s var(--ease), filter 1s var(--ease); filter: saturate(.65); }
  .work-tile:hover img { transform: scale(1.05); filter: saturate(1); }
  .work-tile__shade { position: absolute; inset: 35% 0 0; background: linear-gradient(transparent, rgb(4 12 21 / .9)); }
  .work-tile__meta { position: absolute; right: 1.25rem; bottom: 1.25rem; left: 1.25rem; display: grid; grid-template-columns: 2rem 1fr auto; align-items: end; gap: .75rem; color: white; }
  .work-tile__meta b { align-self: start; color: var(--color-alpha); font-family: var(--font-mono); font-size: .7rem; }
  .work-tile__meta strong { font-family: var(--font-display); font-size: clamp(1.4rem, 2.8vw, 2.6rem); line-height: .95; letter-spacing: -.04em; }
  .work-tile__meta i { font-size: 1.5rem; font-style: normal; }
  .work-note { display: flex; min-height: 18rem; flex-direction: column; justify-content: space-between; padding: clamp(1.5rem, 3vw, 2.5rem); border: 1px solid var(--line); background: var(--surface); }
  .work-note p { max-width: 23rem; font-family: var(--font-display); font-size: clamp(1.35rem, 2.5vw, 2.25rem); line-height: 1.04; letter-spacing: -.035em; }
  @media (max-width: 767px) {
    .new-hero__grid, .work-index__heading, .work-index__grid { grid-template-columns: 1fr; }
    .new-hero__grid { gap: .75rem; min-height: auto; padding-block: .75rem 1.25rem; }
    .new-hero__media { min-height: min(28svh, 15rem); gap: .4rem; }
    .new-hero__footer { align-items: flex-start; flex-direction: column; }
    .work-index__heading { gap: 1.25rem; }
    .work-tile--tall { min-height: 25rem; }
  }

  .showcase-card {
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    box-shadow: 0 18px 50px -24px rgb(0 0 0 / 0.85);
    transition: transform 0.4s var(--ease), border-color 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }

  .showcase-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-alpha);
    box-shadow: 0 20px 40px -10px color-mix(in srgb, var(--color-alpha) 20%, transparent);
  }

  .showcase-card :global(h2),
  .showcase-card :global(h3) {
    text-wrap: balance;
  }

  .showcase-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-cycler]');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words: string[] = JSON.parse(el.dataset.words || '[]');
    el.innerHTML = '';
    const spans = words.map((w, i) => {
      const s = document.createElement('span');
      s.className = 'cycler-word' + (i === 0 ? ' is-current' : '');
      s.textContent = w;
      el.appendChild(s);
      return s;
    });
    let i = 0;
    let timer = 0;
    const step = () => {
      const prev = spans[i];
      i = (i + 1) % spans.length;
      const next = spans[i];
      prev.classList.remove('is-current');
      prev.classList.add('is-leaving');
      next.classList.remove('is-leaving');
      next.style.transition = 'none';
      next.style.transform = 'translateY(150%)';
      next.offsetHeight;
      next.style.transition = '';
      next.style.transform = '';
      next.classList.add('is-current');
      // Park the old word below the line again without animating it back through view.
      window.setTimeout(() => {
        prev.style.transition = 'none';
        prev.classList.remove('is-leaving');
      }, 950);
    };
    const start = () => (timer = window.setInterval(step, 2400));
    start();
    document.addEventListener('visibilitychange', () => {
      clearInterval(timer);
      if (!document.hidden) start();
    });
  }
</script>
