---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import WorkCard from '../components/WorkCard.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, cta } from '../data/site';
import { services } from '../data/services';
import { reasons, process, industries } from '../data/company';
import { projects } from '../data/work';
import { faqs } from '../data/faqs';

const words = ['clinics', 'schools', 'startups', 'gyms', 'brands', 'studios', 'retailers'];
const quick = ['seo-services', 'performance-marketing', 'website-development', 'social-media-marketing', 'app-development', 'branding-graphic-design'];
const featured = projects.slice(0, 4);
const layout = [
  { col: 'md:col-span-7', ratio: '4/3' },
  { col: 'md:col-span-5 md:mt-24', ratio: '4/5' },
  { col: 'md:col-span-5', ratio: '4/5' },
  { col: 'md:col-span-7 md:mt-24', ratio: '4/3' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base
  title="Global Alpha Tech | Digital Marketing, SEO and Website Development in Delhi"
  description="Global Alpha Tech is a digital growth studio in Laxmi Nagar, Delhi. One team for SEO, Google and Meta ads, websites, apps, social media and branding, measured on enquiries and sales."
  schema={faqSchema}
>
  <!-- Hero -->
  <section class="hero-shell wrap pt-8 pb-12 md:pt-12 md:pb-16">
    <div class="hero-topline mb-10 flex flex-wrap items-center justify-between gap-4 md:mb-14">
      <p class="flex items-center gap-3 font-mono text-xs tracking-wide text-muted uppercase" data-reveal>
        <span class="live-dot"></span>
        Digital growth studio, Laxmi Nagar, Delhi
      </p>
      <p class="hidden font-mono text-xs tracking-wide text-muted uppercase md:block" data-reveal style="--d:80ms">
        Websites / Shopify / Meta Ads / Performance Growth
      </p>
    </div>

    <h1 class="hero-title">
      <span class="sr-only">We grow clinics, schools, startups and local businesses online.</span>
      <span aria-hidden="true" class="block" data-lines>
        <span class="line"><span>We grow</span></span>
        <span class="line pl-[7%] md:pl-[21%]">
          <span class="block" style="--d:90ms">
            <span class="cycler light text-accent-text" data-cycler data-words={JSON.stringify(words)}>
              <span class="cycler-word is-current">{words[0]}</span>
            </span>
          </span>
        </span>
        <span class="line text-right"><span style="--d:180ms">online.</span></span>
      </span>
    </h1>
  </section>

  <!-- Real Work Showcase: 3-Column Collage -->
  <section class="pb-4 md:pb-6 px-3 md:px-6" aria-label="Real work and capabilities">

    <!-- Fixed-height collage: all 3 cols share the same height, flex fills space proportionally -->
    <div class="flex flex-col lg:flex-row gap-2.5" style="height: auto;">

      <!-- ── Column 1 (Left): Text card + img-4 ── -->
      <div class="flex flex-col gap-2.5 lg:w-[30%]">

        <!-- Text Card -->
        <div class="showcase-card flex flex-col justify-between gap-5 rounded-2xl border border-line bg-surface/60 p-6 xl:p-8" data-reveal style="flex:1.15">
          <div class="space-y-3">
            <div class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 font-mono text-[0.7rem] uppercase tracking-wider text-muted">
              <span class="size-1.5 rounded-full bg-alpha"></span>
              What we do &middot; Built for revenue
            </div>
            <h2 class="font-display text-xl xl:text-2xl font-[700] leading-[1.18] tracking-tight text-fg">
              Websites, Shopify stores & Meta ads engineered for real enquiries.
            </h2>
            <p class="text-muted leading-relaxed text-sm">
              <strong class="font-[600] text-fg">{site.name}</strong> plans, codes, and scales the actual digital revenue engines of your business. No vague impressions or fake followers. We engineer custom clinic & academy portals, high-speed Shopify stores, and hyper-targeted Meta ad campaigns that deliver paying clients.
            </p>
          </div>
          <div>
            <div class="flex flex-wrap gap-1.5 pb-4">
              <span class="chip text-xs">Custom Web Portals</span>
              <span class="chip text-xs">Shopify Dawn & Liquid</span>
              <span class="chip text-xs">Meta Ads (FB & IG)</span>
              <span class="chip text-xs">Local SEO Growth</span>
            </div>
            <div class="flex flex-wrap items-center gap-3">
              <a href={cta.href} class="btn btn-primary">{cta.label}<Icon name="arrow-right" size={16} /></a>
              <a href="/services/" class="btn btn-ghost text-sm">Explore services</a>
            </div>
          </div>
        </div>

        <!-- img-4: Devriz Professional -->
        <div class="relative overflow-hidden rounded-2xl bg-surface" data-reveal style="--d:120ms; flex:1; min-height:180px;">
          <Media id="home-img-4" alt="Devriz Professional D2C skincare e-commerce website" quiet fill imgClass="object-cover object-top" />
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent px-4 py-3">
            <p class="text-white text-xs font-[600]">Devriz Professional</p>
            <p class="text-white/70 text-[0.7rem]">D2C skincare store</p>
          </div>
        </div>

      </div>

      <!-- ── Column 2 (Center): img-1 + img-2 + img-3 ── -->
      <div class="flex flex-col gap-2.5 lg:w-[40%]">

        <!-- img-1: Meta Ads -->
        <div class="relative overflow-hidden rounded-2xl bg-surface" data-reveal style="--d:60ms; flex:1; min-height:160px;">
          <Media id="home-img-1" alt="Meta Ads Manager multi-platform campaign previews" quiet fill imgClass="object-cover object-top" />
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent px-4 py-3">
            <p class="text-white text-xs font-[600]">Meta & Social Performance Ads</p>
            <p class="text-white/70 text-[0.7rem]">adsmanager.facebook.com</p>
          </div>
        </div>

        <!-- img-2: Shopify Admin -->
        <div class="relative overflow-hidden rounded-2xl bg-surface" data-reveal style="--d:120ms; flex:1; min-height:160px;">
          <Media id="home-img-2" alt="Shopify admin panel Dawn theme customization" quiet fill imgClass="object-cover object-top" />
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent px-4 py-3">
            <p class="text-white text-xs font-[600]">Shopify Store Architecture</p>
            <p class="text-white/70 text-[0.7rem]">admin.shopify.com</p>
          </div>
        </div>

        <!-- img-3: Kotil -->
        <div class="relative overflow-hidden rounded-2xl bg-surface" data-reveal style="--d:180ms; flex:1; min-height:160px;">
          <Media id="home-img-3" alt="Kotil Skin Science clinic and academy website" quiet fill imgClass="object-cover object-top" />
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent px-4 py-3">
            <p class="text-white text-xs font-[600]">Kotil Skin Science</p>
            <p class="text-white/70 text-[0.7rem]">kotilskinscience.com</p>
          </div>
        </div>

      </div>

      <!-- ── Column 3 (Right): img-5 + Text card ── -->
      <div class="flex flex-col gap-2.5 lg:w-[30%]">

        <!-- img-5: Devriz Group -->
        <div class="relative overflow-hidden rounded-2xl bg-surface" data-reveal style="--d:180ms; flex:1; min-height:180px;">
          <Media id="home-img-5" alt="Devriz Group multi-sector corporate enterprise portal" quiet fill imgClass="object-cover object-top" />
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent px-4 py-3">
            <p class="text-white text-xs font-[600]">Devriz Group Corporate</p>
            <p class="text-white/70 text-[0.7rem]">devrizgroup.com</p>
          </div>
        </div>

        <!-- Text Card 2: We Grow -->
        <div class="showcase-card flex flex-col justify-between gap-5 rounded-2xl border border-line bg-surface/60 p-6 xl:p-8" data-reveal style="--d:240ms; flex:1.15">
          <div class="space-y-3">
            <p class="font-mono text-xs uppercase tracking-wider text-accent-text font-[600]">Revenue-driven studio</p>
            <h3 class="font-display text-xl xl:text-2xl font-[700] leading-tight text-fg tracking-tight">
              we grow gyms, schools and businesses.
            </h3>
            <p class="text-muted text-sm leading-relaxed">
              From neighbourhood fitness centres and private schools to medical clinics and D2C brands, we engineer digital pipelines that consistently bring in qualified leads and orders.
            </p>
          </div>
          <div class="space-y-3">
            <div class="grid grid-cols-2 gap-3 border-t border-line pt-4">
              <div>
                <p class="font-display text-2xl xl:text-3xl font-[700] text-fg">2x-4x</p>
                <p class="text-xs text-muted mt-0.5">Enquiry surge</p>
              </div>
              <div>
                <p class="font-display text-2xl xl:text-3xl font-[700] text-fg">100%</p>
                <p class="text-xs text-muted mt-0.5">Accounts in your name</p>
              </div>
            </div>
            <a href="/work/" class="link-arrow text-sm font-[600]">
              See verified client results <Icon name="arrow-up-right" size={16} />
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Marquee -->
  <div class="marquee my-4 md:my-6 border-y border-line py-3 md:py-4" aria-hidden="true">
    <div class="marquee-track" style="--speed:60s">
      {
        [0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {services.map((s) => (
              <span class="flex items-center">
                <span class="px-6 font-display text-[clamp(1.75rem,4vw,3.5rem)] leading-none font-[680] tracking-[-0.035em] whitespace-nowrap md:px-8" style="font-stretch:88%">
                  {s.short.charAt(0).toUpperCase() + s.short.slice(1)}
                </span>
                <Mark size={28} class="text-muted" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- Statement -->
  <section class="wrap pt-6 pb-14 md:pt-8 md:pb-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-8">
        <p class="kicker mb-8" data-reveal>The studio</p>
        <p class="font-display text-[clamp(1.75rem,3.5vw,3.15rem)] leading-[1.12] font-[460] tracking-[-0.03em]" data-reveal>
          We are strategists, designers, developers and marketers in one Delhi studio. <span class="text-muted">So your website, search rankings, ads and content stop working against each other and start pulling in one direction:</span> towards customers.
        </p>
        <div class="mt-10 flex flex-wrap gap-x-10 gap-y-6" data-reveal style="--d:120ms">
          <div>
            <p class="font-display text-4xl font-[700] tracking-tight">{services.length}</p>
            <p class="mt-1 text-sm text-muted">services, one team</p>
          </div>
          <div>
            <p class="font-display text-4xl font-[700] tracking-tight">1</p>
            <p class="mt-1 text-sm text-muted">point of contact for you</p>
          </div>
          <div>
            <p class="font-display text-4xl font-[700] tracking-tight">100%</p>
            <p class="mt-1 text-sm text-muted">of accounts in your name</p>
          </div>
        </div>
      </div>
      <div class="lg:col-span-4" data-reveal style="--d:150ms">
        <Media id="studio-team" alt="The Global Alpha Tech team at work in the studio" class="aspect-[4/5] rounded-[1.25rem]" sizes="(min-width: 1024px) 33vw, 100vw" />
        <a href="/about/" class="link-arrow mt-5">About the studio <Icon name="arrow-up-right" size={18} /></a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="wrap section-y pt-0" aria-labelledby="services-title">
    <SectionHead index="01" label="Services" title="Everything online," light="from one team." intro="Pick one service or let us combine them into a plan. Hover a service to preview it, or open it for the full scope." link={{ label: 'All services', href: '/services/' }} />
    <div class="mt-14 md:mt-20">
      <ServiceIndex />
    </div>
  </section>

  <!-- Why -->
  <section class="theme-night section-y relative overflow-hidden" aria-label="Why Global Alpha Tech">
    <Mark size={640} quiet class="pointer-events-none absolute -top-40 -right-40 text-white/[0.04]" />
    <div class="wrap relative">
      <SectionHead index="02" label="Why Global Alpha Tech" title="Built for revenue," light="not for reports." intro="Plenty of agencies can post, design or run ads. Fewer will tie that work to the money it makes you and show you the numbers every month." />
      <ol class="mt-16 grid gap-px overflow-hidden rounded-[1.25rem] bg-line md:mt-20 md:grid-cols-2 lg:grid-cols-3">
        {
          reasons.map((r, i) => (
            <li class="flex min-h-[15rem] flex-col justify-between gap-10 bg-bg p-7 md:p-9" data-reveal style={`--d:${(i % 3) * 90}ms`}>
              <span class="font-mono text-xs text-alpha-light">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="t-h4 md:text-[1.4rem]">{r.title}</h3>
                <p class="mt-3 text-[0.95rem] text-muted">{r.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Process -->
  <section class="wrap section-y" aria-label="How we work">
    <SectionHead index="03" label="How we work" title="Four steps." light="No surprises." intro="Every engagement follows the same rhythm, whether it is a landing page or a year of growth marketing." link={{ label: 'Plans and pricing', href: '/pricing/' }} />
    <ol class="mt-16 grid gap-10 md:mt-20 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        process.map((step, i) => (
          <li class="group relative pt-8" data-reveal style={`--d:${i * 110}ms`}>
            <span class="absolute top-0 left-0 h-px w-full bg-line-strong" />
            <span class="absolute top-0 left-0 h-px w-full origin-left scale-x-0 bg-alpha transition-transform duration-[1.4s] ease-[var(--ease)] [.is-in>&]:scale-x-100" style={`transition-delay:${300 + i * 200}ms`} />
            <span class="absolute -top-[5px] left-0 size-[11px] rounded-full border-2 border-bg bg-alpha" />
            <p class="font-display text-6xl leading-none font-[220] tracking-[-0.04em] text-muted">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="t-h3 mt-6">{step.title}</h3>
            <p class="mt-3 text-[0.95rem] text-muted">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Work -->
  <section class="wrap section-y pt-0" aria-label="Selected work">
    <SectionHead index="04" label="Selected work" title="Real businesses," light="real results." intro="A few of the projects our clients have described in their own words." link={{ label: 'See all work', href: '/work/' }} />
    <div class="mt-14 grid gap-x-8 gap-y-16 md:mt-20 md:grid-cols-12">
      {featured.map((p, i) => <WorkCard project={p} ratio="16/10" class={layout[i].col} sizes="(min-width: 768px) 55vw, 100vw" />)}
    </div>
  </section>

  <!-- Industries -->
  <section class="border-y border-line bg-surface section-y-sm" aria-label="Industries">
    <div class="wrap grid gap-8 lg:grid-cols-12">
      <p class="kicker lg:col-span-3"><b>05</b>Who we work with</p>
      <ul class="flex flex-wrap gap-x-4 gap-y-2 lg:col-span-9">
        {
          industries.map((name, i) => (
            <li class="flex items-center gap-4 font-display text-[clamp(1.5rem,3vw,2.6rem)] leading-tight font-[600] tracking-[-0.03em]" data-reveal style={`--d:${i * 50}ms`}>
              {name}
              {i < industries.length - 1 && <span class="font-[200] text-muted">/</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Testimonials index="06" />

  <!-- FAQ -->
  <section class="wrap section-y pt-0" aria-labelledby="faq-title">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)]">
          <p class="kicker mb-6" data-reveal><b>07</b>Questions</p>
          <h2 id="faq-title" class="t-h2" data-lines>
            <span class="line"><span>Good questions,</span></span>
            <span class="line"><span class="light" style="--d:100ms">straight answers.</span></span>
          </h2>
          <p class="mt-6 max-w-sm text-muted" data-reveal>
            Something else on your mind? Call <a href={site.phoneHref} class="link-u text-fg">{site.phone}</a> or <a href="/contact/" class="link-u text-fg">send us a message</a>.
          </p>
        </div>
      </div>
      <div class="lg:col-span-8">
        <Faq items={faqs} />
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero-shell {
    position: relative;
    isolation: isolate;
    margin-top: 1rem;
    border: 1px solid var(--color-line);
    border-radius: 2rem;
    background:
      radial-gradient(circle at 82% 18%, color-mix(in srgb, var(--color-alpha) 20%, transparent), transparent 28%),
      linear-gradient(135deg, color-mix(in srgb, var(--color-surface) 92%, transparent), transparent 72%);
    overflow: hidden;
  }

  .hero-shell::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 2rem;
    right: var(--gutter);
    width: min(34rem, 62vw);
    height: min(34rem, 62vw);
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-alpha) 18%, transparent) 0%, transparent 68%);
    filter: blur(8px);
    pointer-events: none;
  }

  .hero-shell::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.32;
    background-image: linear-gradient(var(--color-line) 1px, transparent 1px), linear-gradient(90deg, var(--color-line) 1px, transparent 1px);
    background-size: 4rem 4rem;
    mask-image: linear-gradient(90deg, black, transparent 78%);
    pointer-events: none;
  }

  .hero-topline {
    border-bottom: 1px solid var(--line);
    padding: 0.8rem 0.25rem 1rem;
  }

  .hero-title {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 12.6vw, 13.5rem);
    line-height: 0.88;
    letter-spacing: -0.05em;
    font-weight: 760;
    font-stretch: 84%;
    text-shadow: 0 0 50px color-mix(in srgb, var(--color-alpha) 10%, transparent);
  }

  /* Room for descenders (g, p) inside the masked lines. */
  .hero-title :global(.line) {
    padding-bottom: 0.16em !important;
    margin-bottom: -0.16em !important;
  }

  .cycler {
    display: grid;
    overflow: hidden;
    padding-bottom: 0.16em;
    margin-bottom: -0.16em;
  }

  .cycler :global(.cycler-word) {
    grid-area: 1 / 1;
    justify-self: start;
    white-space: nowrap;
    transform: translateY(150%);
    transition: transform 0.9s var(--ease);
  }

  .cycler :global(.cycler-word.is-current) {
    transform: none;
  }

  .cycler :global(.cycler-word.is-leaving) {
    transform: translateY(-150%);
  }
  .showcase-card {
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    box-shadow: 0 18px 50px -24px rgb(0 0 0 / 0.85);
    transition: transform 0.4s var(--ease), border-color 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }

  .showcase-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-alpha);
    box-shadow: 0 20px 40px -10px color-mix(in srgb, var(--color-alpha) 20%, transparent);
  }

  .showcase-card :global(h2),
  .showcase-card :global(h3) {
    text-wrap: balance;
  }

  .showcase-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-cycler]');
  if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words: string[] = JSON.parse(el.dataset.words || '[]');
    el.innerHTML = '';
    const spans = words.map((w, i) => {
      const s = document.createElement('span');
      s.className = 'cycler-word' + (i === 0 ? ' is-current' : '');
      s.textContent = w;
      el.appendChild(s);
      return s;
    });
    let i = 0;
    let timer = 0;
    const step = () => {
      const prev = spans[i];
      i = (i + 1) % spans.length;
      const next = spans[i];
      prev.classList.remove('is-current');
      prev.classList.add('is-leaving');
      next.classList.remove('is-leaving');
      next.style.transition = 'none';
      next.style.transform = 'translateY(150%)';
      next.offsetHeight;
      next.style.transition = '';
      next.style.transform = '';
      next.classList.add('is-current');
      // Park the old word below the line again without animating it back through view.
      window.setTimeout(() => {
        prev.style.transition = 'none';
        prev.classList.remove('is-leaving');
      }, 950);
    };
    const start = () => (timer = window.setInterval(step, 2400));
    start();
    document.addEventListener('visibilitychange', () => {
      clearInterval(timer);
      if (!document.hidden) start();
    });
  }
</script>
