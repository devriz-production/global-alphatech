---
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import Faq from '../../components/Faq.astro';
import WorkCard from '../../components/WorkCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services, practices, getService, type Service } from '../../data/services';
import { projects } from '../../data/work';
import { site, cta } from '../../data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service: s } = Astro.props as { service: Service };
const practice = practices.find((p) => p.id === s.practice)!;
const related = s.related.map(getService).filter(Boolean) as Service[];
const work = projects.filter((p) => p.services.includes(s.slug)).slice(0, 2);
const url = `${site.url}/services/${s.slug}/`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.name,
    serviceType: s.name,
    description: s.summary,
    url,
    provider: { '@id': `${site.url}/#business` },
    areaServed: [{ '@type': 'City', name: 'Delhi' }, { '@type': 'Country', name: 'India' }],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: `${s.name}: what is included`,
      itemListElement: s.deliverables.map((d) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: d.title, description: d.text } })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: s.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base title={s.metaTitle} description={s.summary} crumbs={[{ label: 'Services', href: '/services/' }, { label: s.name }]} schema={schema}>
  <!-- Header -->
  <section class="wrap pt-8 pb-16 md:pt-14 md:pb-24">
    <nav aria-label="Breadcrumb" class="mb-10 md:mb-14">
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs tracking-wide text-muted uppercase">
        <li><a href="/" class="link-u">Home</a></li>
        <li class="flex items-center gap-2"><span aria-hidden="true" class="opacity-50">/</span><a href="/services/" class="link-u">Services</a></li>
        <li class="flex items-center gap-2"><span aria-hidden="true" class="opacity-50">/</span><span aria-current="page" class="text-fg">{s.name}</span></li>
      </ol>
    </nav>
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="flex flex-col lg:col-span-7">
        <p class="kicker mb-6">{practice.name} / {s.name}</p>
        <h1 class="t-h1" data-lines>
          <span class="line"><span>{s.title}</span></span>
          <span class="line"><span class="light" style="--d:120ms">{s.titleLight}</span></span>
        </h1>
        <p class="t-lead mt-8 max-w-xl text-muted" data-reveal style="--d:200ms">{s.summary}</p>
        <div class="mt-10 flex flex-wrap gap-3" data-reveal style="--d:260ms">
          <a href={`${cta.href}?service=${s.slug}`} class="btn btn-primary">{cta.label}<Icon name="arrow-right" size={18} /></a>
          <a href={site.phoneHref} class="btn btn-ghost"><Icon name="phone" size={18} />{site.phone}</a>
        </div>
        <ul class="mt-auto flex flex-wrap gap-2 pt-12" aria-label="Tools and platforms">
          {s.tools.map((t) => <li class="chip">{t}</li>)}
        </ul>
      </div>
      <div class="lg:col-span-5" data-reveal style="--d:120ms">
        <Media id={`service-${s.slug}`} alt={s.name} ratio="4/5" class="rounded-[1.25rem]" sizes="(min-width: 1024px) 40vw, 100vw" priority />
      </div>
    </div>
  </section>

  <!-- Overview -->
  <section class="border-y border-line bg-surface section-y" aria-label="Overview">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="kicker mb-8" data-reveal><b>01</b>Overview</p>
        <p class="font-display text-[clamp(1.5rem,2.6vw,2.35rem)] leading-[1.22] font-[440] tracking-[-0.025em]" data-reveal>{s.intro}</p>
      </div>
      <div class="lg:col-span-4 lg:col-start-9">
        <p class="t-label text-muted" data-reveal>What changes for you</p>
        <ul class="mt-5 grid gap-4">
          {
            s.outcomes.map((o, i) => (
              <li class="flex gap-4 border-t border-line pt-4" data-reveal style={`--d:${i * 90}ms`}>
                <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-alpha text-white">
                  <Icon name="check" size={14} />
                </span>
                <span>{o}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Deliverables -->
  <section class="wrap section-y" aria-label="What is included">
    <SectionHead index="02" label="What is included" title="The work," light="itemised." intro="Every item below appears in your proposal with dates, owners and how we will measure it." />
    <ol class="mt-14 grid gap-px overflow-hidden rounded-[1.25rem] border border-line bg-line md:mt-20 md:grid-cols-2 lg:grid-cols-3">
      {
        s.deliverables.map((d, i) => (
          <li class="flex flex-col gap-8 bg-bg p-7 md:p-9" data-reveal style={`--d:${(i % 3) * 90}ms`}>
            <span class="font-mono text-xs text-accent-text">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="t-h4 md:text-[1.35rem]">{d.title}</h3>
              <p class="mt-3 text-[0.95rem] text-muted">{d.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Steps -->
  <section class="theme-night section-y" aria-label="How it works">
    <div class="wrap">
      <SectionHead index="03" label="How it works" title="From first call" light="to measurable results." />
      <ol class="mt-14 grid gap-10 md:mt-20 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        {
          s.steps.map((step, i) => (
            <li class="relative pt-8" data-reveal style={`--d:${i * 110}ms`}>
              <span class="absolute top-0 left-0 h-px w-full bg-line-strong" />
              <span class="absolute top-0 left-0 h-px w-full origin-left scale-x-0 bg-alpha-light transition-transform duration-[1.4s] ease-[var(--ease)] [.is-in>&]:scale-x-100" style={`transition-delay:${300 + i * 200}ms`} />
              <p class="font-display text-6xl leading-none font-[220] tracking-[-0.04em] text-muted">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="t-h3 mt-6">{step.title}</h3>
              <p class="mt-3 text-[0.95rem] text-muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Fit -->
  <section class="wrap section-y" aria-label="Who it is for">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="kicker mb-6" data-reveal><b>04</b>Who it is for</p>
        <h2 class="t-h2" data-lines>
          <span class="line"><span>A good fit</span></span>
          <span class="line"><span class="light" style="--d:100ms">if you are...</span></span>
        </h2>
      </div>
      <ul class="grid gap-0 lg:col-span-7">
        {
          s.fit.map((f, i) => (
            <li class="flex items-baseline gap-6 border-b border-line py-6 first:border-t" data-reveal style={`--d:${i * 90}ms`}>
              <span class="font-mono text-xs text-muted">{String(i + 1).padStart(2, '0')}</span>
              <span class="t-h4 md:text-[1.4rem]">{f}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    work.length > 0 && (
      <section class="wrap section-y pt-0" aria-label="Related work">
        <SectionHead index="05" label="Related work" title="Recent work" light="in this area." link={{ label: 'All work', href: '/work/' }} />
        <div class="mt-14 grid gap-x-8 gap-y-16 md:grid-cols-2">
          {work.map((p) => <WorkCard project={p} ratio="4/3" sizes="(min-width: 768px) 45vw, 100vw" />)}
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  <section class="wrap section-y pt-0" aria-labelledby="svc-faq">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="kicker mb-6" data-reveal><b>{work.length ? '06' : '05'}</b>Questions</p>
        <h2 id="svc-faq" class="t-h2" data-lines>
          <span class="line"><span>About {s.short}.</span></span>
        </h2>
      </div>
      <div class="lg:col-span-8">
        <Faq items={s.faqs} />
      </div>
    </div>
  </section>

  <!-- Related services -->
  <section class="wrap pb-12 md:pb-20" aria-labelledby="related-title">
    <h2 id="related-title" class="t-label text-muted">Often paired with</h2>
    <ul class="mt-6 grid border-t border-line md:grid-cols-3">
      {
        related.map((r) => (
          <li class="border-b border-line md:border-r md:pl-7 md:first:pl-0 md:last:border-r-0">
            <a href={`/services/${r.slug}/`} class="group flex h-full flex-col justify-between gap-8 py-7 md:pr-7">
              <span class="t-h3 transition-colors group-hover:text-accent-text">{r.name}</span>
              <span class="flex items-end justify-between gap-6 text-[0.95rem] text-muted">
                {r.summary}
                <Icon name="arrow-up-right" size={20} class="shrink-0 text-fg transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand title={`Talk to us about ${s.short}.`} light="No obligation, no jargon." service={s.slug} />
</Base>
