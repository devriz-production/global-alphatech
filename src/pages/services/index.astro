---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Media from '../../components/Media.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { practices, servicesIn, services, getService } from '../../data/services';

// "Where should I start?" finder: each goal points at the services that answer it.
const goals = [
  { id: 'leads', label: 'More enquiries this month', picks: ['performance-marketing', 'lead-generation'] },
  { id: 'google', label: 'Show up on Google', picks: ['seo-services', 'performance-marketing'] },
  { id: 'website', label: 'A better website', picks: ['website-design', 'website-development'] },
  { id: 'social', label: 'A stronger social presence', picks: ['social-media-marketing', 'branding-graphic-design'] },
  { id: 'brand', label: 'Look more established', picks: ['branding-graphic-design', 'website-design'] },
  { id: 'repeat', label: 'More repeat customers', picks: ['email-marketing', 'lead-generation'] },
  { id: 'app', label: 'Launch an app', picks: ['app-development', 'website-design'] },
  { id: 'systems', label: 'Less manual work', picks: ['digital-transformation-consulting', 'lead-generation'] },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://globalalphatech.com/services/${s.slug}/`, name: s.name })),
};
---

<Base
  title="Services: SEO, Ads, Websites, Apps and Branding"
  description="Eleven digital services from one Delhi team: SEO, Google and Meta ads, social media, lead generation, email, website design and development, apps, branding and consulting."
  crumbs={[{ label: 'Services' }]}
  schema={schema}
>
  <PageHero
    crumbs={[{ label: 'Services' }]}
    label="Services"
    title={`${services.length} services.`}
    light="One accountable team."
    lead="Choose what you need today and add more as you grow, without changing agencies or briefing anyone twice."
  />

  <!-- Goal finder -->
  <section class="wrap pb-16 md:pb-24" aria-labelledby="finder-title" data-finder>
    <div class="rounded-[1.5rem] border border-line bg-surface p-6 md:p-10">
      <div class="grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="t-label text-accent-text">Where to start</p>
          <h2 id="finder-title" class="t-h3 mt-3">What do you want to happen next?</h2>
          <p class="mt-3 text-[0.95rem] text-muted">Pick a goal and we will point you to the services that move it.</p>
        </div>
        <div class="lg:col-span-8">
          <div class="flex flex-wrap gap-2" role="group" aria-label="Goals">
            {
              goals.map((g, i) => (
                <button type="button" class="chip min-h-10 px-4 text-[0.9375rem] text-fg transition-colors hover:border-fg aria-pressed:border-fg aria-pressed:bg-fg aria-pressed:text-bg" aria-pressed={i === 0 ? 'true' : 'false'} data-goal={g.id}>
                  {g.label}
                </button>
              ))
            }
          </div>
          <div class="mt-6" aria-live="polite">
            {
              goals.map((g, i) => (
                <div class="grid gap-3 sm:grid-cols-2" data-answer={g.id} hidden={i !== 0}>
                  {g.picks.map((slug, j) => {
                    const s = getService(slug)!;
                    return (
                      <a href={`/services/${s.slug}/`} class="group flex items-start justify-between gap-4 rounded-2xl border border-line bg-bg p-5 transition-colors hover:border-fg">
                        <span>
                          <span class="t-label text-muted">{j === 0 ? 'Start with' : 'Then add'}</span>
                          <span class="t-h4 mt-1.5 block">{s.name}</span>
                          <span class="mt-1.5 block text-sm text-muted">{s.summary}</span>
                        </span>
                        <Icon name="arrow-up-right" size={18} class="mt-1 shrink-0 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
                      </a>
                    );
                  })}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    practices.map((p, pi) => (
      <section class="wrap pb-20 md:pb-32" aria-labelledby={`practice-${p.id}`}>
        <div class="flex flex-col gap-3 border-t border-line-strong pt-8 md:flex-row md:items-baseline md:justify-between">
          <h2 id={`practice-${p.id}`} class="t-h2">
            <span class="mr-4 align-top font-mono text-sm font-normal tracking-normal text-accent-text">{String(pi + 1).padStart(2, '0')}</span>
            {p.name}
          </h2>
          <p class="text-muted md:text-right">{p.line}</p>
        </div>
        <ul class="mt-10 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {servicesIn(p.id).map((s, i) => (
            <li data-reveal style={`--d:${(i % 3) * 90}ms`}>
              <a href={`/services/${s.slug}/`} class="group block">
                <div class="overflow-hidden rounded-[1.25rem]">
                  <Media id={`service-${s.slug}`} alt={s.name} ratio="4/5" sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw" imgClass="transition-transform duration-[1.2s] ease-[var(--ease)] group-hover:scale-[1.04]" />
                </div>
                <div class="mt-5 flex items-start justify-between gap-4">
                  <h3 class="t-h3 transition-colors group-hover:text-accent-text">{s.name}</h3>
                  <span class="mt-1 grid size-10 shrink-0 place-items-center rounded-full border border-line-strong transition-all duration-500 group-hover:border-alpha group-hover:bg-alpha group-hover:text-white">
                    <Icon name="arrow-up-right" size={18} />
                  </span>
                </div>
                <p class="mt-2 text-[0.95rem] text-muted">{s.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <CtaBand title="Need more than one?" light="Most clients do." text="We combine services into one plan with one team and one report, so nothing falls between the gaps." />
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-finder]');
  if (root) {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-goal]');
    const answers = root.querySelectorAll<HTMLElement>('[data-answer]');
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        answers.forEach((a) => (a.hidden = a.dataset.answer !== b.dataset.goal));
      }),
    );
  }
</script>
