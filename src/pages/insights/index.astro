---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Media from '../../components/Media.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { posts, formatDate } from '../../lib/content';

const [lead, ...rest] = posts;
---

<Base
  title="Insights: Practical Digital Marketing Advice"
  description="Plain language guides on SEO, Google Ads, local search, websites and digital marketing for growing businesses in Delhi and across India."
  crumbs={[{ label: 'Insights' }]}
>
  <PageHero
    crumbs={[{ label: 'Insights' }]}
    label="Insights"
    title="Useful, not"
    light="just interesting."
    lead="Practical guides from the team on search, ads, websites and growth. No jargon, no fluff."
  />

  <section class="wrap pb-20 md:pb-32" aria-label="Articles">
    {
      lead && (
        <a href={`/insights/${lead.slug}/`} class="group grid gap-8 border-t border-line-strong pt-8 lg:grid-cols-12 lg:gap-10" data-reveal>
          <div class="overflow-hidden rounded-[1.25rem] lg:col-span-7">
            <Media id={`insight-${lead.slug}`} alt="" ratio="16/9" sizes="(min-width: 1024px) 55vw, 100vw" imgClass="transition-transform duration-[1.2s] ease-[var(--ease)] group-hover:scale-[1.04]" priority />
          </div>
          <div class="flex flex-col lg:col-span-5">
            <p class="flex flex-wrap items-center gap-3 font-mono text-xs tracking-wide text-muted uppercase">
              <span class="text-accent-text">{lead.category}</span>
              <span aria-hidden="true">/</span>
              <time datetime={lead.updated ?? lead.date}>{formatDate(lead.updated ?? lead.date)}</time>
              <span aria-hidden="true">/</span>
              {lead.minutes} min read
            </p>
            <h2 class="mt-5 font-display text-[clamp(1.8rem,2.9vw,2.75rem)] leading-[1.04] font-[700] tracking-[-0.03em] transition-colors group-hover:text-accent-text" style="font-stretch:92%">{lead.title}</h2>
            <p class="mt-5 text-muted">{lead.description}</p>
            <span class="link-arrow mt-8 lg:mt-auto">
              Read the article <Icon name="arrow-up-right" size={18} />
            </span>
          </div>
        </a>
      )
    }

    <ul class="mt-20 grid gap-x-8 gap-y-16 md:grid-cols-2 lg:grid-cols-3">
      {
        rest.map((p, i) => (
          <li data-reveal style={`--d:${(i % 3) * 90}ms`}>
            <a href={`/insights/${p.slug}/`} class="group block">
              <div class="overflow-hidden rounded-[1.25rem]">
                <Media id={`insight-${p.slug}`} alt="" ratio="16/10" sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 100vw" imgClass="transition-transform duration-[1.2s] ease-[var(--ease)] group-hover:scale-[1.04]" />
              </div>
              <p class="mt-5 flex flex-wrap items-center gap-3 font-mono text-xs tracking-wide text-muted uppercase">
                <span class="text-accent-text">{p.category}</span>
                <span aria-hidden="true">/</span>
                {p.minutes} min read
              </p>
              <h2 class="t-h3 mt-3 transition-colors group-hover:text-accent-text">{p.title}</h2>
              <p class="mt-3 text-[0.95rem] text-muted">{p.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand title="Rather we did it for you?" light="That is what we are here for." />
</Base>
