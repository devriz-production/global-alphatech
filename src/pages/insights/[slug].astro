---
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { posts, formatDate } from '../../lib/content';
import { getService } from '../../data/services';
import { site, cta } from '../../data/site';

export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props as { post: (typeof posts)[number] };
const { Content } = post;
const toc = post.headings.filter((h) => h.depth === 2);
const more = posts.filter((p) => p.slug !== post.slug).slice(0, 2);
const linked = (post.services ?? []).map(getService).filter(Boolean);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.date,
  dateModified: post.updated ?? post.date,
  mainEntityOfPage: `${site.url}/insights/${post.slug}/`,
  image: `${site.url}/og.png`,
  author: { '@type': 'Organization', name: site.name, url: site.url },
  publisher: { '@id': `${site.url}/#business` },
};
---

<Base title={post.title} description={post.description} type="article" crumbs={[{ label: 'Insights', href: '/insights/' }, { label: post.title }]} schema={schema}>
  <article>
    <header class="wrap pt-8 pb-12 md:pt-14 md:pb-16">
      <nav aria-label="Breadcrumb" class="mb-10 md:mb-14">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs tracking-wide text-muted uppercase">
          <li><a href="/" class="link-u">Home</a></li>
          <li class="flex items-center gap-2"><span aria-hidden="true" class="opacity-50">/</span><a href="/insights/" class="link-u">Insights</a></li>
          <li class="flex items-center gap-2"><span aria-hidden="true" class="opacity-50">/</span><span aria-current="page" class="text-fg">{post.category}</span></li>
        </ol>
      </nav>
      <div class="max-w-4xl">
        <p class="flex flex-wrap items-center gap-3 font-mono text-xs tracking-wide text-muted uppercase">
          <span class="text-accent-text">{post.category}</span>
          <span aria-hidden="true">/</span>
          <time datetime={post.date}>{formatDate(post.date)}</time>
          {post.updated && (<><span aria-hidden="true">/</span><span>Updated <time datetime={post.updated}>{formatDate(post.updated)}</time></span></>)}
          <span aria-hidden="true">/</span>
          {post.minutes} min read
        </p>
        <h1 class="mt-6 font-display text-[clamp(2.3rem,5vw,4.5rem)] leading-[1] font-[720] tracking-[-0.035em]" style="font-stretch:90%" data-reveal>{post.title}</h1>
        <p class="t-lead mt-6 max-w-3xl text-muted" data-reveal style="--d:120ms">{post.description}</p>
      </div>
    </header>

    <div class="wrap">
      <Media id={`insight-${post.slug}`} alt="" ratio="16/7" class="rounded-[1.25rem]" sizes="100vw" priority />
    </div>

    <div class="wrap grid gap-12 py-16 md:py-24 lg:grid-cols-12">
      <aside class="hidden lg:col-span-3 lg:block">
        <div class="sticky top-[calc(var(--header-h)+2rem)]">
          <p class="t-label text-muted">In this article</p>
          <ol class="mt-4 grid gap-2 border-l border-line text-sm">
            {
              toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="-ml-px block border-l border-transparent py-1 pl-4 text-muted transition-colors hover:border-alpha hover:text-fg" data-toc={h.slug}>
                    {h.text}
                  </a>
                </li>
              ))
            }
          </ol>
          <a href={cta.href} class="btn btn-primary btn-sm mt-10">{cta.label}<Icon name="arrow-right" size={16} /></a>
        </div>
      </aside>

      <div class="min-w-0 lg:col-span-7 lg:col-start-5">
        <div class="article">
          <Content />
        </div>

        <footer class="mt-16 grid gap-6 border-t border-line pt-8">
          <p class="text-sm text-muted">Written by the {site.name} team, Laxmi Nagar, Delhi.</p>
          {
            linked.length > 0 && (
              <div>
                <p class="t-label text-muted">Related services</p>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {linked.map((s) => (
                    <li>
                      <a href={`/services/${s!.slug}/`} class="chip transition-colors hover:border-fg hover:text-fg">
                        {s!.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </footer>
      </div>
    </div>
  </article>

  {
    more.length > 0 && (
      <section class="wrap pb-16 md:pb-24" aria-labelledby="more-title">
        <h2 id="more-title" class="t-label text-muted">Keep reading</h2>
        <ul class="mt-6 grid border-t border-line md:grid-cols-2">
          {more.map((p) => (
            <li class="border-b border-line md:odd:border-r md:odd:pr-8 md:even:pl-8">
              <a href={`/insights/${p.slug}/`} class="group flex h-full flex-col justify-between gap-6 py-8">
                <span class="font-mono text-xs tracking-wide text-accent-text uppercase">{p.category}</span>
                <span class="t-h3 transition-colors group-hover:text-accent-text">{p.title}</span>
                <span class="link-arrow text-sm">
                  Read <Icon name="arrow-up-right" size={16} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <CtaBand />
</Base>

<script>
  // Highlight the current section in the table of contents.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc!, a]));
  if (links.size) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a, id) => {
            const on = id === e.target.id;
            a.classList.toggle('!text-fg', on);
            a.classList.toggle('!border-alpha', on);
          });
        }
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );
    links.forEach((_, id) => {
      const h = document.getElementById(id);
      if (h) io.observe(h);
    });
  }
</script>
