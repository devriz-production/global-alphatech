---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { legal, formatDate } from '../lib/content';

export function getStaticPaths() {
  return legal.map((doc) => ({ params: { legal: doc.slug }, props: { doc } }));
}

const { doc } = Astro.props as { doc: (typeof legal)[number] };
const { Content } = doc;
---

<Base title={doc.title.charAt(0).toUpperCase() + doc.title.slice(1)} description={doc.description} crumbs={[{ label: doc.title }]}>
  <PageHero crumbs={[{ label: doc.title }]} label={`Last updated ${formatDate(doc.updated)}`} title={doc.title.charAt(0).toUpperCase() + doc.title.slice(1)} />
  <div class="wrap pb-24 md:pb-32">
    <div class="grid lg:grid-cols-12">
      <div class="article lg:col-span-7 lg:col-start-4">
        <Content />
      </div>
    </div>
  </div>
</Base>
