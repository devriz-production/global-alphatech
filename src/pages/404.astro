---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import { services } from '../data/services';

const popular = services.filter((s) => ['seo-services', 'performance-marketing', 'website-development', 'social-media-marketing'].includes(s.slug));
---

<Base title="Page not found" description="The page you were looking for has moved or no longer exists. Find your way back to Global Alpha Tech's services, work and contact details." noindex>
  <section class="wrap py-20 md:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="kicker mb-6">Error 404</p>
        <h1 class="t-h1">This page has<br /><span class="light">left the orbit.</span></h1>
        <p class="t-lead mt-6 max-w-lg text-muted">The address may be mistyped, or the page may have moved when we rebuilt the website. These will get you back on track:</p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/" class="btn btn-primary">Go to the homepage<Icon name="arrow-right" size={18} /></a>
          <a href="/contact/" class="btn btn-ghost">Contact us</a>
        </div>
        <ul class="mt-12 grid max-w-lg border-t border-line">
          {
            popular.map((s) => (
              <li class="border-b border-line">
                <a href={`/services/${s.slug}/`} class="group flex items-center justify-between py-4 font-[540]">
                  {s.name}
                  <Icon name="arrow-up-right" size={16} class="text-muted transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="hidden justify-center lg:col-span-5 lg:flex">
        <Mark size={360} spin class="text-fg/80" />
      </div>
    </div>
  </section>
</Base>
