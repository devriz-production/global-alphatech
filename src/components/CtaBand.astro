---
// The dark "Start a project" band near the foot of most pages, over an optional looping video.
import Media from './Media.astro';
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import { site, whatsappLink, cta } from '../data/site';

interface Props {
  title?: string;
  light?: string;
  text?: string;
  service?: string;
}
const {
  title = 'Ready when you are.',
  light = 'Tell us where you want to grow.',
  text = 'Share a few lines about your business and what you want to achieve. We reply with next steps, and a fixed quote once we understand the work.',
  service,
} = Astro.props;
const wa = whatsappLink();
const href = service ? `${cta.href}?service=${service}` : cta.href;
---

<section class="wrap py-6 md:py-10">
  <div class="theme-night relative isolate overflow-hidden rounded-[1.75rem]">
    <Mark size={560} quiet class="pointer-events-none absolute -right-28 -bottom-48 -z-10 text-white/[0.05]" />
    <Media id="home-cta-loop" alt="" fill quiet class="-z-10 !bg-transparent opacity-45" sizes="100vw" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-night via-night/80 to-night/30"></div>
    <div class="grid gap-10 px-6 py-16 md:grid-cols-12 md:px-14 md:py-24">
      <div class="md:col-span-8">
        <h2 class="t-h2" data-lines>
          <span class="line"><span>{title}</span></span>
          <span class="line"><span class="light text-alpha-light" style="--d:100ms">{light}</span></span>
        </h2>
        <p class="mt-6 max-w-xl text-muted" data-reveal style="--d:150ms">{text}</p>
      </div>
      <div class="flex flex-col justify-end gap-3 md:col-span-4" data-reveal style="--d:200ms">
        <a href={href} class="btn btn-alpha w-full">{cta.label}<Icon name="arrow-right" size={18} /></a>
        <div class="grid grid-cols-2 gap-3">
          <a href={site.phoneHref} class="btn btn-ghost w-full"><Icon name="phone" size={18} />Call</a>
          {wa ? <a href={wa} target="_blank" rel="noopener" class="btn btn-ghost w-full"><Icon name="whatsapp" size={18} />WhatsApp</a> : <a href={`mailto:${site.email}`} class="btn btn-ghost w-full"><Icon name="mail" size={18} />Email</a>}
        </div>
      </div>
    </div>
  </div>
</section>
