---
// One large quote at a time. A horizontal scroll-snap track, so swiping works on phones
// and the buttons simply scroll it. Clients get initials, never generated faces.
import Icon from './Icon.astro';
import { testimonials } from '../data/work';

interface Props {
  index?: string;
}
const { index } = Astro.props;

const initials = (name: string) =>
  name
    .split(' ')
    .map((p) => p[0])
    .join('')
    .slice(0, 2);
---

<section class="section-y overflow-hidden" aria-labelledby="voices-title" data-quotes>
  <div class="wrap grid gap-12 lg:grid-cols-12">
    <div class="flex flex-col justify-between gap-8 lg:col-span-4">
      <div>
        <p class="kicker mb-6" data-reveal>{index && <b>{index}</b>}Client voices</p>
        <h2 id="voices-title" class="t-h2" data-lines>
          <span class="line"><span>In their words,</span></span>
          <span class="line"><span class="light" style="--d:100ms">not ours.</span></span>
        </h2>
      </div>
      <div class="flex items-center gap-4">
        <button type="button" class="grid size-12 place-items-center rounded-full border border-line-strong transition-colors hover:border-fg hover:bg-fg hover:text-bg disabled:opacity-35 disabled:hover:border-line-strong disabled:hover:bg-transparent disabled:hover:text-fg" aria-label="Previous quote" data-prev>
          <Icon name="arrow-left" size={18} />
        </button>
        <button type="button" class="grid size-12 place-items-center rounded-full border border-line-strong transition-colors hover:border-fg hover:bg-fg hover:text-bg disabled:opacity-35 disabled:hover:border-line-strong disabled:hover:bg-transparent disabled:hover:text-fg" aria-label="Next quote" data-next>
          <Icon name="arrow-right" size={18} />
        </button>
        <p class="ml-2 font-mono text-sm text-muted tabular-nums" aria-live="polite">
          <span data-current>01</span> / {String(testimonials.length).padStart(2, '0')}
        </p>
      </div>
    </div>

    <div class="min-w-0 lg:col-span-8">
      <ul class="flex snap-x snap-mandatory gap-6 overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-track tabindex="0" aria-label="Client quotes">
        {
          testimonials.map((t, i) => (
            <li class="w-full shrink-0 snap-start" aria-roledescription="slide" aria-label={`${i + 1} of ${testimonials.length}`}>
              <figure class="flex h-full flex-col justify-between gap-10 border-t border-line-strong pt-8">
                <blockquote class="font-display text-[clamp(1.6rem,3.2vw,2.75rem)] leading-[1.12] font-[420] tracking-[-0.025em]">
                  <span class="text-accent-text">&ldquo;</span>
                  {t.quote}
                  <span class="text-accent-text">&rdquo;</span>
                </blockquote>
                <figcaption class="flex items-center gap-4">
                  <span class="grid size-12 place-items-center rounded-full bg-fg font-mono text-sm text-bg" aria-hidden="true">
                    {initials(t.name)}
                  </span>
                  <span>
                    <span class="block font-[600]">{t.name}</span>
                    <span class="block text-sm text-muted">{t.role}</span>
                  </span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-quotes]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const current = root.querySelector<HTMLElement>('[data-current]')!;
    const slides = [...track.children] as HTMLElement[];

    const index = () => Math.round(track.scrollLeft / (slides[0].offsetWidth + 24));
    const go = (i: number) => {
      const slide = slides[Math.max(0, Math.min(slides.length - 1, i))];
      track.scrollTo({ left: slide.offsetLeft - slides[0].offsetLeft, behavior: 'smooth' });
    };
    const update = () => {
      const i = index();
      current.textContent = String(i + 1).padStart(2, '0');
      prev.disabled = i <= 0;
      next.disabled = i >= slides.length - 1;
    };

    prev.addEventListener('click', () => go(index() - 1));
    next.addEventListener('click', () => go(index() + 1));
    track.addEventListener('scrollend', update);
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(index() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(index() - 1); }
    });
    // Browsers without scrollend still update via a short debounce.
    let t: number | undefined;
    track.addEventListener('scroll', () => { clearTimeout(t); t = window.setTimeout(update, 120); }, { passive: true });
    update();
  });
</script>
