---
// The orbit mark: three orbits around a nucleus, after the atom in the company logo.
// One electron is picked out in the accent violet.
interface Props {
  size?: number;
  class?: string;
  spin?: boolean;
  quiet?: boolean; // one colour throughout, for large background watermarks
}
const { size = 32, class: cls = '', spin = false, quiet = false } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  class:list={['shrink-0', cls, spin && 'mark-spin']}
  aria-hidden="true"
>
  <g stroke="currentColor" stroke-width="1.4">
    <ellipse cx="16" cy="16" rx="13" ry="5.2"></ellipse>
    <ellipse cx="16" cy="16" rx="13" ry="5.2" transform="rotate(60 16 16)"></ellipse>
    <ellipse cx="16" cy="16" rx="13" ry="5.2" transform="rotate(120 16 16)"></ellipse>
  </g>
  <circle cx="16" cy="16" r="2.6" fill="currentColor"></circle>
  <g class="mark-electron">
    <circle cx="29" cy="16" r="2.1" fill={quiet ? 'currentColor' : '#6A3DF0'}></circle>
  </g>
</svg>

<style>
  .mark-spin .mark-electron {
    transform-origin: 16px 16px;
    animation: orbit 9s linear infinite;
  }

  @keyframes orbit {
    to {
      transform: rotate(360deg);
    }
  }
</style>
