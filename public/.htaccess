# Global Alpha Tech: Apache settings for Hostinger.
# Upload this file with the rest of dist/. File Manager hides it by default (it starts with a dot).

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use HTTPS and the bare domain.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(globalalphatech\.com)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # ---- Old WordPress addresses -> new pages (permanent) ----
  RewriteRule ^portfolio/?$ /work/ [R=301,L]
  RewriteRule ^blog/?$ /insights/ [R=301,L]
  RewriteRule ^top-digital-marketing-agency-in-delhi-2026-global-alpha-tech/?$ /insights/top-digital-marketing-agency-in-delhi-2026-global-alpha-tech/ [R=301,L]
  RewriteRule ^hello-world/?$ /insights/ [R=301,L]
  RewriteRule ^category/ /insights/ [R=301,L]
  RewriteRule ^20[0-9]{2}/ /insights/ [R=301,L]
  RewriteRule ^feed/?$ /insights/ [R=301,L]
  RewriteRule ^comments/feed/?$ /insights/ [R=301,L]
  RewriteRule ^pricing-plans/?$ /pricing/ [R=301,L]
  RewriteRule ^our-services/?$ /services/ [R=301,L]
  RewriteRule ^contact-us/?$ /contact/ [R=301,L]
  RewriteRule ^about-us/?$ /about/ [R=301,L]
  RewriteRule ^(shop|cart|checkout|my-account)(/.*)?$ /services/ [R=301,L]

  # Old WordPress system paths no longer exist.
  RewriteRule ^(wp-admin|wp-content|wp-includes)(/.*)?$ - [G,L]
  RewriteRule ^(wp-login|xmlrpc)\.php$ - [G,L]

  # Add the trailing slash to page folders (/about -> /about/).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# ---- Caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# Files in /_astro/ have a content hash in their name and are cached for a year
# by the separate .htaccess inside that folder.

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml
</IfModule>
